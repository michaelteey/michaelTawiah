---
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'michael tawiah — performance marketer & dj',
  description = 'technical digital performance marketing specialist investing £500k+/mth in ad spend. also a dj.',
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-6B0YVD7ZQ8"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-6B0YVD7ZQ8');
    </script>
  </head>
  <body>
    <slot />

    <script>
      // Sticky snap guard: a section taller than the viewport must not be
      // a snap target, otherwise mandatory snapping yanks the reader away
      // from content they haven't reached yet.
      const snapSections = document.querySelectorAll('.snap');
      if (snapSections.length) {
        let raf = 0;
        const applyGuards = () => {
          snapSections.forEach((s) => {
            const tooTall = s.scrollHeight > window.innerHeight + 8;
            s.style.scrollSnapAlign = tooTall ? 'none' : '';
            s.style.scrollSnapStop = tooTall ? 'normal' : '';
          });
        };
        const schedule = () => {
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(applyGuards);
        };
        applyGuards();
        window.addEventListener('resize', schedule);
        window.addEventListener('orientationchange', schedule);
        // re-measure once fonts land, since they change content height
        if (document.fonts?.ready) document.fonts.ready.then(schedule);
      }

      const els = document.querySelectorAll('.reveal');
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.08 }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #000000;
    --fg: #e8e8e8;
    --muted: #6b6b6b;
    --dim: #3a3a3a;
    --accent: #00ff9d;
    --accent-dim: rgba(0, 255, 157, 0.15);
    --border: #1a1a1a;
    --card: #0a0a0a;
    --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  html {
    scroll-behavior: smooth;
  }

  /* Full-viewport sticky snap: one section per gesture. Sections taller
     than the viewport get their snap-align stripped at runtime (see the
     guard script) so they can never trap the reader mid-content. */
  .snap {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  @media (min-height: 600px) {
    html {
      scroll-snap-type: y mandatory;
    }
  }

  /* tighter vertical rhythm so a section actually fits one screen */
  .snap.section {
    padding-top: 6.5rem;
    padding-bottom: 4rem;
  }
  .snap .section-label { margin-bottom: 1.75rem; }
  .snap .section-title-lg { margin-bottom: 2.25rem; }

  @media (max-height: 800px) {
    .snap.section { padding-top: 5.5rem; padding-bottom: 3rem; }
    .snap .section-label { margin-bottom: 1.25rem; }
    .snap .section-title-lg { margin-bottom: 1.5rem; }
  }

  /* reveal-on-scroll */
  .reveal {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reveal.is-in {
    opacity: 1;
    transform: none;
  }
  .reveal-d1 { transition-delay: 0.08s; }
  .reveal-d2 { transition-delay: 0.16s; }
  .reveal-d3 { transition-delay: 0.24s; }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-snap-type: none; scroll-behavior: auto; }
    .reveal { opacity: 1; transform: none; transition: none; }
  }

  body {
    min-height: 100vh;
    overflow-x: hidden;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover {
    color: var(--accent);
  }

  ::selection {
    background: var(--accent);
    color: #000;
  }

  /* shared section primitives */
  .section {
    max-width: 1100px;
    margin: 0 auto;
    padding: 6rem 2rem;
    border-top: 1px solid var(--border);
  }
  .section:first-of-type {
    border-top: none;
  }
  .section-label {
    color: var(--accent);
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    margin-bottom: 3rem;
  }
  .section-title {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    margin: 0 0 1.5rem;
    letter-spacing: -0.01em;
  }
  .section-title-lg {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin-bottom: 3rem;
  }
  .muted {
    color: var(--muted);
  }
  .hl {
    color: var(--fg);
    font-weight: 500;
  }
  .inline-link {
    color: var(--accent);
    border-bottom: 1px solid var(--accent-dim);
    transition: border-color 0.2s ease;
  }
  .inline-link:hover {
    border-bottom-color: var(--accent);
    color: var(--accent);
  }

  @media (max-width: 860px) {
    .section { padding: 4rem 1.25rem; }
  }
</style>
