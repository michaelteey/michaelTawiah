---
import { caseStudies } from '../data/clients';
import HScroller from './HScroller.astro';

interface Props {
  layout?: 'grid' | 'row';
}
const { layout = 'grid' } = Astro.props;
---

{layout === 'row' ? (
  <HScroller id="cases" label="Case studies">
    {caseStudies.map((cs, i) => (
      <article class="case-card case-card-slide">
        <div class="case-index">{String(i + 1).padStart(2, '0')} / {String(caseStudies.length).padStart(2, '0')}</div>
        <div class="case-logo">
          {cs.logo ? (
            <img src={cs.logo} alt={`${cs.name} logo`} loading="lazy" />
          ) : (
            <span class={`wordmark wordmark-${cs.mark}`}>{cs.name}</span>
          )}
        </div>
        <div class="case-role">{cs.role}</div>
        <p class="case-summary">{cs.summary}</p>
        {cs.metrics && (
          <div class="metrics">
            {cs.metrics.map((m) => (
              <div class="metric">
                <div class="metric-label">{m.label}</div>
                <div class="metric-move">
                  <span class="metric-from">{m.from}</span>
                  <span class="metric-arrow">→</span>
                  <span class="metric-to">{m.to}</span>
                </div>
              </div>
            ))}
          </div>
        )}
        <ul class="case-highlights">
          {cs.highlights.map((h) => (
            <li><span class="tick">→</span>{h}</li>
          ))}
        </ul>
      </article>
    ))}
  </HScroller>
) : (
  <div class="case-grid">
    {caseStudies.map((cs) => (
      <article class="case-card">
        <div class="case-logo">
          {cs.logo ? (
            <img src={cs.logo} alt={`${cs.name} logo`} loading="lazy" />
          ) : (
            <span class={`wordmark wordmark-${cs.mark}`}>{cs.name}</span>
          )}
        </div>
        <div class="case-role">{cs.role}</div>
        <p class="case-summary">{cs.summary}</p>
        {cs.metrics && (
          <div class="metrics">
            {cs.metrics.map((m) => (
              <div class="metric">
                <div class="metric-label">{m.label}</div>
                <div class="metric-move">
                  <span class="metric-from">{m.from}</span>
                  <span class="metric-arrow">→</span>
                  <span class="metric-to">{m.to}</span>
                </div>
              </div>
            ))}
          </div>
        )}
        <ul class="case-highlights">
          {cs.highlights.map((h) => (
            <li><span class="tick">→</span>{h}</li>
          ))}
        </ul>
      </article>
    ))}
  </div>
)}

<style>
  .case-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  .case-card-slide {
    flex: 0 0 auto;
    width: min(78vw, 380px);
    scroll-snap-align: start;
  }
  .case-index {
    color: var(--dim);
    font-size: 0.65rem;
    letter-spacing: 0.25em;
    margin-bottom: 1.25rem;
  }
  .case-card {
    border: 1px solid var(--border);
    background: var(--card);
    padding: 2.25rem 2rem;
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .case-card:hover {
    border-color: var(--accent-dim);
    transform: translateY(-2px);
  }
  .case-logo {
    min-height: 64px;
    display: flex;
    align-items: center;
    margin-bottom: 1.5rem;
  }
  /* logo assets are pre-recoloured to --fg, so no filter is applied */
  .case-logo img {
    max-height: 42px;
    max-width: 170px;
    object-fit: contain;
    display: block;
  }
  .wordmark {
    font-size: 1.75rem;
    color: var(--fg);
    line-height: 1;
  }
  /* tiktok — black app, cyan/pink glitch offsets */
  .wordmark-tiktok {
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #fff;
    text-shadow: 2px 0 rgba(0, 242, 234, 0.75), -2px 0 rgba(254, 44, 85, 0.75);
  }
  /* vanquish — stark black/white athletic wordmark */
  .wordmark-vanquish {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 1.35rem;
    color: #ffffff;
  }
  /* 33mm — heavy rounded italic slab, mirroring their real wordmark */
  .wordmark-thirtythreemm {
    font-family: 'Arial Black', 'Helvetica Neue', Helvetica, sans-serif;
    font-weight: 900;
    font-style: italic;
    letter-spacing: -0.02em;
    font-size: 2rem;
    color: var(--fg);
  }
  /* mvf — cream wordmark on dark */
  .wordmark-mvf {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: #ede6d6;
  }
  .case-role {
    color: var(--accent);
    font-size: 0.7rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    margin-bottom: 0.9rem;
  }
  .case-summary {
    color: #b8b8b8;
    font-size: 0.9rem;
    line-height: 1.7;
    margin: 0 0 1.25rem;
  }
  .metrics {
    display: grid;
    gap: 0.5rem;
    margin: 0 0 1.1rem;
    padding: 0.85rem 0;
    border-top: 1px dashed var(--border);
    border-bottom: 1px dashed var(--border);
  }
  .metric-label {
    color: var(--dim);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 0.2rem;
  }
  .metric-move {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 0.95rem;
  }
  .metric-from {
    color: var(--muted);
    text-decoration: line-through;
    text-decoration-color: var(--dim);
  }
  .metric-arrow { color: var(--dim); font-size: 0.75rem; }
  .metric-to {
    color: var(--accent);
    font-weight: 500;
  }

  .case-highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .case-highlights li {
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.6;
    display: flex;
    gap: 0.6rem;
  }
  .tick {
    color: var(--accent);
    flex-shrink: 0;
  }

  @media (max-width: 760px) {
    .case-grid { grid-template-columns: 1fr; gap: 1.25rem; }
  }

  /* the metrics block adds height; keep the horizontal cards inside a
     single snapped viewport on shorter screens */
  @media (max-height: 940px) {
    .case-card-slide { padding: 1.5rem 1.4rem; }
    .case-card-slide .case-index { margin-bottom: 0.85rem; }
    .case-card-slide .case-logo { min-height: 44px; margin-bottom: 1rem; }
    .case-card-slide .case-logo img { max-height: 32px; }
    .case-card-slide .wordmark { font-size: 1.35rem; }
    .case-card-slide .wordmark-thirtythreemm { font-size: 1.15rem; }
    .case-card-slide .case-role { margin-bottom: 0.6rem; }
    .case-card-slide .case-summary {
      font-size: 0.82rem;
      line-height: 1.6;
      margin-bottom: 0.9rem;
    }
    .case-card-slide .metrics { padding: 0.6rem 0; margin-bottom: 0.85rem; gap: 0.4rem; }
    .case-card-slide .metric-move { font-size: 0.85rem; }
    .case-card-slide .case-highlights { gap: 0.35rem; }
    .case-card-slide .case-highlights li { font-size: 0.76rem; line-height: 1.5; }
  }
</style>
