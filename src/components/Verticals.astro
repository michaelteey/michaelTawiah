---
const verticals = [
  {
    k: 'e-commerce',
    brands: '33mm · vanquish fitness · emma j shipley',
    lead: 'end-to-end budget ownership, judged on revenue rather than platform metrics.',
    points: [
      'managing full monthly budgets, from allocation down to ad level',
      'which revenue is driving performance — not just which ads are',
      'blended cac, roas and contribution across the whole account',
      'product, price point and cohort analysis feeding the media plan',
    ],
  },
  {
    k: 'lead generation',
    brands: 'the care side · mvf · world vision · active content',
    lead: 'a technical edge game — win on testing velocity and volume of iterations.',
    points: [
      'heavy a/b and creative testing as the default operating mode',
      'launch extremely quickly, pause just as quickly',
      'identify what works and double, then triple down at pace',
      'scaling budgets fast without losing efficiency',
    ],
  },
];
---

<div class="vert" data-stagger data-stagger-gap="110">
  {verticals.map((v) => (
    <article class="vert-panel">
      <div class="vert-k">{v.k}</div>
      <div class="vert-brands">{v.brands}</div>
      <p class="vert-lead">{v.lead}</p>
      <ul class="vert-points">
        {v.points.map((p) => (
          <li><span class="vert-tick">→</span>{p}</li>
        ))}
      </ul>
    </article>
  ))}
</div>

<style>
  .vert {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  .vert-panel {
    border: 1px solid var(--border);
    background: var(--card);
    padding: 2rem 1.85rem;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .vert-panel:hover {
    border-color: var(--accent-dim);
    transform: translateY(-2px);
  }
  .vert-k {
    color: var(--accent);
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    margin-bottom: 0.6rem;
  }
  .vert-brands {
    color: var(--dim);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    margin-bottom: 1.1rem;
  }
  .vert-lead {
    color: var(--fg);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0 0 1.25rem;
  }
  .vert-points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }
  .vert-points li {
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.6;
    display: flex;
    gap: 0.6rem;
  }
  .vert-tick { color: var(--accent); flex-shrink: 0; }

  @media (max-width: 860px) {
    .vert { grid-template-columns: 1fr; gap: 0.85rem; }
    .vert-panel { padding: 1.35rem 1.4rem; }
    .vert-lead { font-size: 0.85rem; margin-bottom: 0.85rem; }
    .vert-points { gap: 0.4rem; }
    .vert-points li { font-size: 0.76rem; }
  }
</style>
