---
// Ambient rain field. Deliberately low-contrast — it should read as
// texture behind the type, never as a foreground element.
---

<canvas class="rain" aria-hidden="true" data-rain></canvas>

<style>
  .rain {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0.16;
    /* fade the field out toward the centre so headline type stays clean */
    -webkit-mask-image: radial-gradient(
      ellipse 55% 45% at 50% 45%,
      transparent 10%,
      #000 75%
    );
    mask-image: radial-gradient(
      ellipse 55% 45% at 50% 45%,
      transparent 10%,
      #000 75%
    );
  }

  @media (prefers-reduced-motion: reduce) {
    .rain { display: none; }
  }
</style>

<script>
  const canvas = document.querySelector('[data-rain]') as HTMLCanvasElement | null;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canvas && !reduce) {
    const ctx = canvas.getContext('2d', { alpha: true })!;
    const GLYPHS = 'アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホ0123456789';
    const FONT = 14;

    let cols = 0;
    let drops: number[] = [];
    let speeds: number[] = [];
    let dpr = 1;

    const resize = () => {
      const r = canvas.parentElement!.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.floor(r.width * dpr);
      canvas.height = Math.floor(r.height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cols = Math.ceil(r.width / FONT);
      drops = Array.from({ length: cols }, () => Math.random() * -60);
      speeds = Array.from({ length: cols }, () => 0.35 + Math.random() * 0.55);
      ctx.font = `${FONT}px "JetBrains Mono", monospace`;
    };

    let running = false;
    let raf = 0;
    let last = 0;

    const draw = (now: number) => {
      if (!running) return;
      // throttle to ~24fps — this is background texture, not a game
      if (now - last > 41) {
        last = now;
        const w = canvas.width / dpr;
        const h = canvas.height / dpr;

        // translucent wipe leaves the fading trail behind each glyph
        ctx.fillStyle = 'rgba(0, 0, 0, 0.10)';
        ctx.fillRect(0, 0, w, h);

        for (let i = 0; i < cols; i++) {
          const y = drops[i] * FONT;
          if (y > 0 && y < h + FONT) {
            const g = GLYPHS[(Math.random() * GLYPHS.length) | 0];
            // leading glyph is brighter, giving the column a head
            ctx.fillStyle = Math.random() > 0.94 ? '#9dffe6' : '#00ffc8';
            ctx.fillText(g, i * FONT, y);
          }
          drops[i] += speeds[i];
          if (y > h && Math.random() > 0.975) drops[i] = Math.random() * -20;
        }
      }
      raf = requestAnimationFrame(draw);
    };

    const start = () => {
      if (running) return;
      running = true;
      last = 0;
      raf = requestAnimationFrame(draw);
    };
    const stop = () => {
      running = false;
      cancelAnimationFrame(raf);
    };

    resize();
    window.addEventListener('resize', resize);

    // only animate while the hero is actually on screen
    const io = new IntersectionObserver(
      ([e]) => (e.isIntersecting ? start() : stop()),
      { threshold: 0.05 }
    );
    io.observe(canvas.parentElement!);

    // and never in a background tab
    document.addEventListener('visibilitychange', () =>
      document.hidden ? stop() : io.takeRecords().length || start()
    );
  }
</script>
