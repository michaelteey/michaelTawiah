---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CaseStudies from '../components/CaseStudies.astro';
import Marquee from '../components/Marquee.astro';
import Stats from '../components/Stats.astro';
import FitAccordion from '../components/FitAccordion.astro';
import StackTabs from '../components/StackTabs.astro';
import HScroller from '../components/HScroller.astro';
import AutomatedAds from '../components/AutomatedAds.astro';
import Breakdown from '../components/Breakdown.astro';
import Verticals from '../components/Verticals.astro';

const services = [
  {
    n: '01',
    title: 'technical paid media',
    body: "end-to-end management across meta, google and tiktok — run by a technical specialist, not a generalist. every variable broken out, tested and acted on before the competition sees it.",
    tags: ['creative testing', 'granular analysis', 'fast iteration'],
  },
  {
    n: '02',
    title: 'growth & measurement',
    body: "blended cac, blended roas, contribution and incrementality. pixel and tag implementation, plus the infrastructure needed to trust the numbers you're spending against.",
    tags: ['blended cac', 'incrementality', 'tagging'],
  },
  {
    n: '03',
    title: 'insight beyond promotion',
    body: "marketing is one p of four. i execute promotion — and feed the analysis into product, price and place, because that's where the rest of the growth actually sits.",
    tags: ['pricing analysis', 'product mix', 'cohorts'],
  },
  {
    n: '04',
    title: 'automation & tooling',
    body: 'python-powered reporting, api integrations and custom builds — the automation layer that makes the granularity above practical rather than theoretical.',
    tags: ['python', 'apis', 'automatedAds'],
  },
];
---

<Layout title="michael tawiah — performance marketer & dj">
  <Nav current="home" />

  <main id="top">
    <!-- 01 — hero -->
    <section class="hero snap">
      <div class="hero-glow"></div>
      <div class="hero-inner">
        <h1 class="hero-title">michaelTawiah<span class="dot">.</span></h1>
        <p class="hero-tagline">sharper insights. faster execution.<span class="caret"></span></p>
        <p class="hero-sub">performance marketer for brands spending serious budgets</p>
      </div>
      <div class="hero-foot">
        <Marquee />
      </div>
    </section>

    <!-- 02 — about + animated stats -->
    <section class="section snap" id="about">
      <div class="section-label reveal">about</div>
      <div class="about-grid">
        <div class="about-text reveal reveal-d1">
          <h2 class="section-title">hey — i'm mike.</h2>
          <p>
            i'm a <span class="hl">technical performance marketer</span> — not a
            general one. <span class="hl">10+ years</span> running end-to-end paid
            across meta, google and tiktok, managing upwards of
            <span class="hl">£500k/mth</span>.
          </p>
          <p>
            marketing is only one part of the funnel. product, price, place and
            promotion — i execute the <span class="hl">promotion</span>, and play a
            heavy analysis and insight role across the rest, because that's where
            most of the growth is actually hiding.
          </p>
          <p>
            the edge is resolution: breaking out variables most teams never see,
            then moving on them fast. that's also why i built
            <a href="https://www.automated-ads.com" class="inline-link">automatedAds</a>.
          </p>
        </div>
        <aside class="about-meta reveal reveal-d2">
          <div class="meta-row"><span class="meta-k">role</span><span class="meta-v">performance marketer</span></div>
          <div class="meta-row"><span class="meta-k">platform</span><span class="meta-v">automatedAds</span></div>
          <div class="meta-row"><span class="meta-k">clients</span><span class="meta-v"><a href="/clients" class="inline-link">see work ↗</a></span></div>
          <div class="meta-row"><span class="meta-k">pricing</span><span class="meta-v"><a href="/pricing" class="inline-link">view tiers ↗</a></span></div>
          <div class="meta-row"><span class="meta-k">status</span><span class="meta-v"><span class="pulse"></span>available</span></div>
        </aside>
      </div>
      <div class="reveal reveal-d3 stats-wrap">
        <Stats />
      </div>
    </section>

    <!-- 03 — case studies, horizontal -->
    <section class="section snap" id="work">
      <div class="section-label reveal">selected work</div>
      <h2 class="section-title section-title-lg reveal reveal-d1">brands i've driven growth for</h2>
      <div class="reveal reveal-d2">
        <CaseStudies layout="row" />
      </div>
      <p class="work-more reveal reveal-d3">
        <a href="/clients" class="inline-link">see everyone i've worked with ↗</a>
      </p>
    </section>

    <!-- 04 — automatedAds -->
    <section class="section snap" id="automatedads">
      <div class="section-label reveal">the platform</div>
      <h2 class="section-title section-title-lg reveal reveal-d1">i built the tooling i run on</h2>
      <div class="reveal reveal-d2">
        <AutomatedAds />
      </div>
    </section>

    <!-- 05 — services, horizontal -->
    <section class="section snap" id="services">
      <div class="section-head reveal">
        <div>
          <div class="section-label">what i do</div>
          <h2 class="section-title section-title-lg">four ways i drive growth</h2>
        </div>
      </div>
      <div class="reveal reveal-d1">
        <HScroller id="services" label="Services">
          {services.map((s) => (
            <article class="svc">
              <div class="svc-n">{s.n}</div>
              <h3 class="svc-title">{s.title}</h3>
              <p class="svc-body">{s.body}</p>
              <div class="svc-tags">
                {s.tags.map((t) => <span class="svc-tag">{t}</span>)}
              </div>
            </article>
          ))}
        </HScroller>
      </div>
    </section>

    <!-- 06 — how i break it down -->
    <section class="section snap" id="method">
      <div class="section-label reveal">the method</div>
      <h2 class="section-title section-title-lg reveal reveal-d1">how i break things down</h2>
      <div class="reveal reveal-d2">
        <Breakdown />
      </div>
    </section>

    <!-- 07 — ecom vs lead gen -->
    <section class="section snap" id="verticals">
      <div class="section-label reveal">where i work</div>
      <h2 class="section-title section-title-lg reveal reveal-d1">two very different games</h2>
      <div class="reveal reveal-d2">
        <Verticals />
      </div>
    </section>

    <!-- 08 — fit, accordion -->
    <section class="section snap" id="fit">
      <div class="section-label reveal">the fit</div>
      <h2 class="section-title section-title-lg reveal reveal-d1">we could be a good fit if —</h2>
      <div class="reveal reveal-d2">
        <FitAccordion />
      </div>
    </section>

    <!-- 09 — stack, filterable -->
    <section class="section snap" id="skills">
      <div class="section-label reveal">the stack</div>
      <h2 class="section-title section-title-lg reveal reveal-d1">everything i touch</h2>
      <div class="reveal reveal-d2">
        <StackTabs />
      </div>
    </section>

    <!-- 10 — cta -->
    <section class="section snap cta-section">
      <div class="cta-grid">
        <article class="cta-card cta-card-alt reveal">
          <div class="cta-label cta-label-alt">start here</div>
          <div class="cta-kicker">marketing</div>
          <h3 class="cta-title">i need a<br />performance marketer</h3>
          <p class="cta-body">
            end-to-end paid across meta, tiktok and google. blended measurement,
            budget allocation, granular optimisation.
          </p>
          <a
            href="https://calendly.com/michaeltawiah/autoads"
            target="_blank"
            rel="noopener noreferrer"
            class="cta-btn cta-btn-solid"
          >book a free 30-min chat</a>
        </article>
        <article class="cta-card reveal reveal-d1">
          <div class="cta-label">platform</div>
          <div class="cta-kicker">automatedAds</div>
          <h3 class="cta-title">i want<br />self-serve tooling</h3>
          <p class="cta-body">
            connect your meta ad account for free access to campaign trends,
            creative performance and breakdowns.
          </p>
          <a href="https://www.automated-ads.com" class="cta-btn cta-btn-outline">go to automatedAds</a>
        </article>
        <article class="cta-card reveal reveal-d2">
          <div class="cta-label">after hours</div>
          <div class="cta-kicker">dj</div>
          <h3 class="cta-title">i need a<br />dj</h3>
          <p class="cta-body">
            house, afro, garage, and everything adjacent. private events, clubs,
            brand activations.
          </p>
          <a href="mailto:me@michaeltawiah.com" class="cta-btn cta-btn-outline">email me@michaeltawiah.com</a>
        </article>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ---------- hero ---------- */
  .hero {
    position: relative;
    justify-content: space-between;
    text-align: center;
    overflow: hidden;
    padding: 0;
  }
  .hero-inner {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 7rem 2rem 2rem;
  }
  .hero-foot { position: relative; }
  .hero-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 60% 45% at 50% 45%,
      rgba(0, 255, 200, 0.08),
      transparent 70%
    );
    pointer-events: none;
  }
  .hero-title {
    position: relative;
    font-family: var(--font-mono);
    font-size: clamp(2.5rem, 8vw, 5.5rem);
    font-weight: 500;
    margin: 0;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .hero-title .dot { color: var(--fg); }
  .hero-tagline {
    position: relative;
    color: var(--accent);
    margin: 1.25rem 0 0;
    font-size: clamp(0.9rem, 2vw, 1.1rem);
  }
  .hero-sub {
    position: relative;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.7rem;
    margin: 1.5rem 0 0;
  }

  /* ---------- about ---------- */
  .about-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 4rem;
    align-items: start;
  }
  .about-text p {
    color: #b8b8b8;
    margin: 0 0 1rem;
    max-width: 52ch;
  }
  .stats-wrap { margin-top: 2.5rem; }
  .about-meta {
    border: 1px solid var(--border);
    background: var(--card);
    padding: 1.5rem;
  }
  .meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 0;
    font-size: 0.8rem;
    border-bottom: 1px solid var(--border);
  }
  .meta-row:last-child { border-bottom: none; }
  .meta-k {
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 0.7rem;
  }
  .meta-v {
    color: var(--fg);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 rgba(0, 255, 200, 0.6);
    animation: pulse-ring 1.8s ease-in-out infinite;
    display: inline-block;
  }
  @keyframes pulse-ring {
    0% { box-shadow: 0 0 0 0 rgba(0, 255, 200, 0.6); }
    70% { box-shadow: 0 0 0 8px rgba(0, 255, 200, 0); }
    100% { box-shadow: 0 0 0 0 rgba(0, 255, 200, 0); }
  }

  /* ---------- services (horizontal) ---------- */
  .section-head { margin-bottom: 2.5rem; }
  .section-head .section-title { margin-bottom: 0; }
  .svc {
    flex: 0 0 auto;
    width: min(78vw, 340px);
    scroll-snap-align: start;
    border: 1px solid var(--border);
    background: var(--card);
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    min-height: 300px;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .svc:hover {
    border-color: var(--accent-dim);
    transform: translateY(-2px);
  }
  .svc-n {
    color: var(--accent-deep);
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    margin-bottom: 2rem;
  }
  .svc-title {
    font-size: 1.05rem;
    font-weight: 500;
    margin: 0 0 1rem;
    line-height: 1.3;
  }
  .svc-body {
    color: var(--muted);
    font-size: 0.85rem;
    margin: 0 0 1.5rem;
    flex: 1;
  }
  .svc-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .svc-tag {
    border: 1px solid var(--border);
    color: var(--dim);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    padding: 0.3rem 0.55rem;
    text-transform: uppercase;
  }

  .work-more {
    margin: 2rem 0 0;
    font-size: 0.85rem;
  }

  /* ---------- cta ---------- */
  .cta-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .cta-card {
    position: relative;
    border: 1px solid var(--border);
    background: var(--card);
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
  }
  .cta-card-alt { border-color: var(--accent-dim); }
  .cta-label {
    position: absolute;
    top: -10px;
    left: 2.5rem;
    background: var(--card);
    border: 1px solid var(--border);
    color: var(--muted);
    padding: 0.25rem 0.6rem;
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .cta-label-alt {
    color: #000;
    background: var(--accent);
    border-color: var(--accent);
  }
  .cta-kicker {
    color: var(--accent);
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    margin: 0.5rem 0 1.25rem;
  }
  .cta-title {
    font-size: 1.4rem;
    font-weight: 500;
    margin: 0 0 1rem;
    line-height: 1.3;
  }
  .cta-body {
    color: var(--muted);
    font-size: 0.85rem;
    margin: 0 0 2rem;
    flex: 1;
  }
  .cta-btn {
    align-self: flex-start;
    display: inline-block;
    padding: 0.85rem 1.25rem;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .cta-btn-outline {
    border: 1px solid var(--fg);
    color: var(--fg);
  }
  .cta-btn-outline:hover { background: var(--fg); color: #000; }
  .cta-btn-solid {
    background: var(--accent);
    color: #000;
    border: 1px solid var(--accent);
    font-weight: 500;
  }
  .cta-btn-solid:hover { background: transparent; color: var(--accent); }

  /* ---------- responsive ---------- */
  @media (max-width: 1020px) {
    .cta-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 860px) {
    .hero-inner { padding: 6rem 1.25rem 2rem; }
    .about-grid { grid-template-columns: 1fr; gap: 2rem; }
    .stats-wrap { margin-top: 2.5rem; }

    /* Stacked single column: three full-size cards can't fit one
       viewport, which clipped the dj card's button below the fold.
       Compact the cards so the whole set stays on screen. */
    .cta-grid { grid-template-columns: 1fr; gap: 0.75rem; }
    .cta-card { padding: 1.4rem 1.5rem; }
    .cta-label { left: 1.5rem; }
    .cta-kicker { margin: 0.2rem 0 0.6rem; }
    .cta-title { font-size: 1.1rem; margin-bottom: 0.55rem; }
    .cta-body {
      font-size: 0.8rem;
      margin-bottom: 1rem;
      flex: 0 1 auto;
    }
    .cta-btn { padding: 0.7rem 1rem; font-size: 0.7rem; }
  }
</style>
