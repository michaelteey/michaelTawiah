---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { clients, caseStudies } from '../data/clients';

const grouped = clients.reduce<Record<string, typeof clients>>((acc, c) => {
  const key = c.sector ?? 'other';
  (acc[key] ??= []).push(c);
  return acc;
}, {});
const sectors = Object.keys(grouped).sort();
---

<Layout
  title="clients — michael tawiah"
  description="brands and businesses i've worked with across 10+ years of performance marketing."
>
  <Nav current="clients" />

  <main id="top">
    <section class="page-hero">
      <div class="hero-glow"></div>
      <div class="page-label">clients</div>
      <h1 class="page-title">trusted by.</h1>
      <p class="page-tagline">10+ years. dozens of brands.</p>
    </section>

    <section class="section">
      <div class="section-label">case studies</div>
      <div class="case-grid">
        {caseStudies.map((cs) => (
          <article class="case-card">
            <div class="case-logo">
              {cs.logo ? (
                <img src={cs.logo} alt={`${cs.name} logo`} loading="lazy" />
              ) : (
                <span class={`wordmark wordmark-${cs.mark}`}>{cs.name}</span>
              )}
            </div>
            <div class="case-role">{cs.role}</div>
            <p class="case-summary">{cs.summary}</p>
            <ul class="case-highlights">
              {cs.highlights.map((h) => (
                <li><span class="tick">→</span>{h}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section-label">also worked with</div>
      {clients.length === 0 ? (
        <div class="empty">
          <p class="muted">client list landing soon — populating shortly.</p>
        </div>
      ) : (
        <div class="sectors">
          {sectors.map((sector) => (
            <div class="sector-group">
              <div class="sector-label">{sector}</div>
              <div class="client-grid">
                {grouped[sector].map((c) => (
                  <article class="client-card">
                    {c.url ? (
                      <a
                        href={c.url}
                        class="client-name"
                        target="_blank"
                        rel="noopener noreferrer"
                      >{c.name} ↗</a>
                    ) : (
                      <span class="client-name">{c.name}</span>
                    )}
                    {c.note && <p class="client-note">{c.note}</p>}
                  </article>
                ))}
              </div>
            </div>
          ))}
        </div>
      )}

      <div class="cta-row">
        <a
          href="https://calendly.com/michaeltawiah/autoads"
          target="_blank"
          rel="noopener noreferrer"
          class="cta-btn cta-btn-solid"
        >book a free 30-min chat</a>
        <a href="/" class="cta-btn cta-btn-outline">← back to home</a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .page-hero {
    position: relative;
    padding: 9rem 2rem 4rem;
    text-align: center;
    overflow: hidden;
  }
  .hero-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 60% 60% at 50% 50%,
      rgba(0, 255, 157, 0.08),
      transparent 70%
    );
    pointer-events: none;
  }
  .page-label {
    position: relative;
    color: var(--accent);
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }
  .page-title {
    position: relative;
    font-family: var(--font-mono);
    font-size: clamp(2.25rem, 7vw, 4rem);
    font-weight: 500;
    margin: 0;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .page-tagline {
    position: relative;
    color: var(--accent);
    margin: 1.25rem 0 0;
    font-size: clamp(0.9rem, 2vw, 1.1rem);
  }

  .empty {
    border: 1px dashed var(--border);
    background: var(--card);
    padding: 4rem 2rem;
    text-align: center;
  }

  /* ---------- case studies ---------- */
  .case-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  .case-card {
    border: 1px solid var(--border);
    background: var(--card);
    padding: 2.25rem 2rem;
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .case-card:hover {
    border-color: var(--accent-dim);
    transform: translateY(-2px);
  }
  .case-logo {
    min-height: 64px;
    display: flex;
    align-items: center;
    margin-bottom: 1.5rem;
  }
  .case-logo img {
    max-height: 48px;
    max-width: 180px;
    object-fit: contain;
    filter: grayscale(1) brightness(1.6);
  }
  .wordmark {
    font-size: 1.75rem;
    color: var(--fg);
    line-height: 1;
  }
  .wordmark-tiktok {
    font-weight: 700;
    letter-spacing: -0.03em;
    text-shadow: 2px 0 rgba(0, 242, 234, 0.55), -2px 0 rgba(255, 0, 80, 0.55);
  }
  .wordmark-vanquish {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 1.35rem;
  }
  .wordmark-thirtythreemm {
    font-weight: 500;
    letter-spacing: 0.05em;
    border: 2px solid var(--fg);
    padding: 0.35rem 0.75rem;
  }
  .wordmark-mvf {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.3em;
  }
  .case-role {
    color: var(--accent);
    font-size: 0.7rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    margin-bottom: 0.9rem;
  }
  .case-summary {
    color: #b8b8b8;
    font-size: 0.9rem;
    line-height: 1.7;
    margin: 0 0 1.25rem;
  }
  .case-highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .case-highlights li {
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.6;
    display: flex;
    gap: 0.6rem;
  }
  .tick {
    color: var(--accent);
    flex-shrink: 0;
  }

  .sectors {
    display: grid;
    gap: 3rem;
  }
  .sector-group {
    border-top: 1px dashed var(--border);
    padding-top: 1.5rem;
  }
  .sector-group:first-child {
    border-top: none;
    padding-top: 0;
  }
  .sector-label {
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.3em;
    font-size: 0.7rem;
    margin-bottom: 1.5rem;
  }
  .client-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
  }
  .client-card {
    border: 1px solid var(--border);
    background: var(--card);
    padding: 1.25rem 1.25rem;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .client-card:hover {
    border-color: var(--accent-dim);
    transform: translateY(-2px);
  }
  .client-name {
    color: var(--fg);
    font-size: 0.95rem;
    font-weight: 500;
    display: inline-block;
  }
  a.client-name {
    transition: color 0.2s ease;
  }
  a.client-name:hover {
    color: var(--accent);
  }
  .client-note {
    color: var(--muted);
    font-size: 0.8rem;
    margin: 0.4rem 0 0;
  }

  .cta-row {
    margin-top: 4rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .cta-btn {
    display: inline-block;
    padding: 0.85rem 1.25rem;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .cta-btn-outline {
    border: 1px solid var(--fg);
    color: var(--fg);
  }
  .cta-btn-outline:hover {
    background: var(--fg);
    color: #000;
  }
  .cta-btn-solid {
    background: var(--accent);
    color: #000;
    border: 1px solid var(--accent);
    font-weight: 500;
  }
  .cta-btn-solid:hover {
    background: transparent;
    color: var(--accent);
  }

  @media (max-width: 760px) {
    .case-grid { grid-template-columns: 1fr; gap: 1.25rem; }
  }
</style>
